<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Centraliza\Connector\Core\Port\ClockInterface" type="Centraliza\Connector\Infra\Time\SystemClock"/>
    <preference for="Centraliza\Connector\Core\Port\CircuitStoreInterface" type="Centraliza\Connector\Infra\Persistence\CircuitStore"/>
    <preference for="Centraliza\Connector\Core\Port\RetryStoreInterface" type="Centraliza\Connector\Infra\Persistence\RetryStore"/>
    <preference for="Centraliza\Connector\Core\Port\QuarantineStoreInterface" type="Centraliza\Connector\Infra\Persistence\QuarantineStore"/>
    <preference for="Centraliza\Connector\Core\Port\TelemetryInterface" type="Centraliza\Connector\Infra\Telemetry\CompositeTelemetry"/>
    <type name="Centraliza\Connector\Infra\Telemetry\CompositeTelemetry">
        <arguments>
            <argument name="destinations" xsi:type="array">
                <item name="new_relic" xsi:type="object">Centraliza\Connector\Infra\Telemetry\NewRelicTelemetry</item>
                <item name="log" xsi:type="object">Centraliza\Connector\Infra\Telemetry\LogTelemetry</item>
            </argument>
        </arguments>
    </type>
    <preference for="Centraliza\Connector\Core\Port\RecordReaderInterface" type="Centraliza\Connector\Entity\RecordReader"/>
    <preference for="Centraliza\Connector\Core\Policy\DeliveryPolicyInterface" type="Centraliza\Connector\Core\Policy\ConnectionEventPolicy"/>
    <preference for="Centraliza\Connector\Core\Port\ChangeRecorderInterface" type="Centraliza\Connector\Capture\Collector"/>
    <preference for="Centraliza\Connector\Core\Port\EventPublisherInterface" type="Centraliza\Connector\Infra\Queue\GuardedPublisher"/>
    <preference for="Centraliza\Connector\Core\Port\TransactionStateInterface" type="Centraliza\Connector\Infra\Db\TransactionState"/>
    <preference for="Centraliza\Connector\Core\Port\SettingsInterface" type="Centraliza\Connector\Infra\Config\Settings"/>
    <preference for="Centraliza\Connector\Core\Port\IdGeneratorInterface" type="Centraliza\Connector\Infra\Id\UuidGenerator"/>
    <preference for="Centraliza\Connector\Core\Port\DeliveryLogInterface" type="Centraliza\Connector\Infra\Persistence\DeliveryLog"/>

    <!-- Whole-stream sends asked from the admin dashboard, in the order the dashboard lists them. -->
    <type name="Centraliza\Connector\Backfill\BackfillService">
        <arguments>
            <!-- Straight to the queue: a failed publish stops the page, which the next run puts on the queue again. -->
            <argument name="publisher" xsi:type="object">Centraliza\Connector\Infra\Queue\QueuePublisher</argument>
            <argument name="sources" xsi:type="array">
                <item name="products" xsi:type="object">Centraliza\Connector\Backfill\Source\ProductSource</item>
                <item name="prices" xsi:type="object">Centraliza\Connector\Backfill\Source\ProductSource</item>
                <item name="stock" xsi:type="object">Centraliza\Connector\Backfill\Source\StockSource</item>
                <item name="locations" xsi:type="object">Centraliza\Connector\Backfill\Source\LocationSource</item>
                <item name="customers" xsi:type="object">Centraliza\Connector\Backfill\Source\CustomerSource</item>
                <item name="customer_groups" xsi:type="object">Centraliza\Connector\Backfill\Source\CustomerGroupSource</item>
                <item name="orders" xsi:type="object">Centraliza\Connector\Backfill\Source\OrderSource</item>
                <item name="carts" xsi:type="object">Centraliza\Connector\Backfill\Source\CartSource</item>
            </argument>
        </arguments>
    </type>

    <!-- "Sent requests" and "Order Notifications" grids. -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="centraliza_connector_delivery_listing_data_source" xsi:type="string">CentralizaConnectorDeliveryLogGridCollection</item>
                <item name="centraliza_connector_notification_listing_data_source" xsi:type="string">CentralizaConnectorNotificationListingSearchResult</item>
                <item name="centraliza_connector_abandoned_cart_listing_data_source" xsi:type="string">CentralizaConnectorAbandonedCartListingSearchResult</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="CentralizaConnectorDeliveryLogGridCollection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">centraliza_connector_delivery_log</argument>
            <argument name="resourceModel" xsi:type="string">Centraliza\Connector\Infra\Persistence\ResourceModel\DeliveryLog</argument>
        </arguments>
    </virtualType>

    <!-- The collector is built on the first commit of every request; the queue stack behind it only when there is something to publish. -->
    <type name="Centraliza\Connector\Capture\Collector">
        <arguments>
            <argument name="publisher" xsi:type="object">Centraliza\Connector\Infra\Queue\GuardedPublisher\Proxy</argument>
        </arguments>
    </type>

    <type name="Centraliza\Connector\Core\Stream\StreamRegistry">
        <arguments>
            <argument name="streams" xsi:type="array">
                <item name="products" xsi:type="array">
                    <item name="lane" xsi:type="string">bulk</item>
                    <item name="key" xsi:type="array">
                        <item name="sku" xsi:type="string">sku</item>
                    </item>
                    <item name="optional" xsi:type="array">
                        <item name="previous_sku" xsi:type="string">previous_sku</item>
                    </item>
                </item>
                <item name="prices" xsi:type="array">
                    <item name="lane" xsi:type="string">bulk</item>
                    <item name="key" xsi:type="array">
                        <item name="sku" xsi:type="string">sku</item>
                    </item>
                </item>
                <item name="locations" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="source_code" xsi:type="string">source_code</item>
                    </item>
                </item>
                <item name="customers" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="customer_id" xsi:type="string">customer_id</item>
                        <item name="email" xsi:type="string">email</item>
                    </item>
                </item>
                <item name="customer_groups" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="group_id" xsi:type="string">group_id</item>
                        <item name="code" xsi:type="string">code</item>
                    </item>
                </item>
                <item name="orders" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="order_id" xsi:type="string">order_id</item>
                        <item name="increment_id" xsi:type="string">increment_id</item>
                    </item>
                </item>
                <item name="carts" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="cart_id" xsi:type="string">cart_id</item>
                    </item>
                </item>
                <item name="stock" xsi:type="array">
                    <item name="lane" xsi:type="string">realtime</item>
                    <item name="key" xsi:type="array">
                        <item name="sku" xsi:type="string">sku</item>
                        <item name="source_code" xsi:type="string">source_code</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- One reader per stream. A stream with no reader would be reported with its key only. -->
    <type name="Centraliza\Connector\Entity\RecordReader">
        <arguments>
            <argument name="readers" xsi:type="array">
                <item name="products" xsi:type="object">Centraliza\Connector\Entity\Product\ProductReader</item>
                <item name="prices" xsi:type="object">Centraliza\Connector\Entity\Price\PriceReader</item>
                <item name="stock" xsi:type="object">Centraliza\Connector\Entity\Stock\StockReader</item>
                <item name="locations" xsi:type="object">Centraliza\Connector\Entity\Location\LocationReader</item>
                <item name="customers" xsi:type="object">Centraliza\Connector\Entity\Customer\CustomerReader</item>
                <item name="customer_groups" xsi:type="object">Centraliza\Connector\Entity\CustomerGroup\CustomerGroupReader</item>
                <item name="orders" xsi:type="object">Centraliza\Connector\Entity\Order\OrderReader</item>
                <item name="carts" xsi:type="object">Centraliza\Connector\Entity\Cart\CartReader</item>
            </argument>
        </arguments>
    </type>

    <preference for="Centraliza\Connector\Core\Port\TransportInterface" type="Centraliza\Connector\Infra\Http\SwitchingTransport"/>

    <type name="Centraliza\Connector\Infra\Http\HttpTransport">
        <arguments>
            <argument name="client" xsi:type="object">GuzzleHttp\Client</argument>
        </arguments>
    </type>

    <!--
        Messaging: the order and cart messages ported from the legacy Centraliza modules (Messaging/). Virtual
        types carry a CentralizaConnector prefix: their names are global, and the legacy modules use the
        unprefixed ones.
    -->
    <preference for="Centraliza\Connector\Messaging\Api\ConfigInterface" type="Centraliza\Connector\Messaging\Model\Config"/>
    <preference for="Centraliza\Connector\Messaging\Api\CentralizaClientInterface" type="Centraliza\Connector\Messaging\Model\Api\Client"/>
    <preference for="Centraliza\Connector\Messaging\Api\Data\ConnectionResultInterface" type="Centraliza\Connector\Messaging\Model\Data\ConnectionResult"/>
    <preference for="Centraliza\Connector\Messaging\Api\ConnectionValidatorInterface" type="Centraliza\Connector\Messaging\Model\Auth\ConnectionValidator"/>
    <preference for="Centraliza\Connector\Messaging\Api\ScopeResolverInterface" type="Centraliza\Connector\Messaging\Model\Config\ScopeResolver"/>
    <preference for="Centraliza\Connector\Messaging\Api\StoreScopeInterface" type="Centraliza\Connector\Messaging\Model\Store\StoreScope"/>
    <preference for="Centraliza\Connector\Messaging\Api\ApiKeyGroupingInterface" type="Centraliza\Connector\Messaging\Model\Api\ApiKeyGrouping"/>
    <preference for="Centraliza\Connector\Messaging\Api\PhoneNumberFormatterInterface" type="Centraliza\Connector\Messaging\Model\Phone\PhoneNumberFormatter"/>
    <preference for="Centraliza\Connector\Messaging\Api\QuotaReservationInterface" type="Centraliza\Connector\Messaging\Model\Api\QuotaReservation"/>
    <preference for="Centraliza\Connector\Messaging\Api\RotationInterface" type="Centraliza\Connector\Messaging\Model\Api\Rotation"/>
    <preference for="Centraliza\Connector\Messaging\Api\KeyLockInterface" type="Centraliza\Connector\Messaging\Model\Lock\KeyLock"/>
    <!-- Monolog\Logger: the framework logger's inherited handlers would copy every entry to system.log. -->
    <virtualType name="CentralizaConnectorMessagingLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">centraliza</argument>
            <argument name="handlers" xsi:type="array">
                <item name="centraliza" xsi:type="object">Centraliza\Connector\Messaging\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Centraliza\Connector\Messaging\Model\Api\FailSafeLogger">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorMessagingLogger</argument>
        </arguments>
    </type>
    <!-- An unwritable centraliza.log must not turn a log call into an exception that aborts a save or a send. -->
    <virtualType name="CentralizaConnectorSafeLogger" type="Centraliza\Connector\Messaging\Model\Api\FailSafeLogger">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorMessagingLogger</argument>
        </arguments>
    </virtualType>
    <!-- Routine trace lines of the messaging flows: written only while Debug Log is on. -->
    <virtualType name="CentralizaConnectorDebugLogger" type="Centraliza\Connector\Messaging\Model\Api\DebugLogger">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </virtualType>
    <type name="Centraliza\Connector\Messaging\Model\Auth\ConnectionValidator">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <argument name="client" xsi:type="object">CentralizaConnectorInteractiveClient</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\Api\QuotaReservation">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\Auth\RejectedKeyStore">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\Lock\KeyLock">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\Api\ApiKeyGrouping">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <!-- A logging failure after the response must not replace the answer Centraliza already gave. -->
    <type name="Centraliza\Connector\Messaging\Model\Api\ClientFactory">
        <arguments>
            <argument name="logger" xsi:type="object">Centraliza\Connector\Messaging\Model\Api\FailSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\Api\Client">
        <arguments>
            <argument name="logger" xsi:type="object">Centraliza\Connector\Messaging\Model\Api\FailSafeLogger</argument>
        </arguments>
    </type>
    <!-- Priority is fixed per injected client; the plain preference is transactional (order messages). -->
    <virtualType name="CentralizaConnectorInteractiveClient" type="Centraliza\Connector\Messaging\Model\Api\Client">
        <arguments>
            <argument name="priority" xsi:type="const">Centraliza\Connector\Messaging\Api\QuotaReservationInterface::PRIORITY_INTERACTIVE</argument>
        </arguments>
    </virtualType>
    <virtualType name="CentralizaConnectorMarketingClient" type="Centraliza\Connector\Messaging\Model\Api\Client">
        <arguments>
            <argument name="priority" xsi:type="const">Centraliza\Connector\Messaging\Api\QuotaReservationInterface::PRIORITY_MARKETING</argument>
        </arguments>
    </virtualType>
    <!-- Connection events take the bulk share of the key's quota. -->
    <type name="Centraliza\Connector\Infra\Http\SharedQuota">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>

    <!-- Order notifications, ported from Centraliza_Sales. -->
    <preference for="Centraliza\Connector\Messaging\Api\OrderNotificationConfigInterface" type="Centraliza\Connector\Messaging\Model\OrderNotification\Config"/>
    <preference for="Centraliza\Connector\Messaging\Api\NotificationDeliveryManagementInterface" type="Centraliza\Connector\Messaging\Model\OrderNotification\NotificationDeliveryManagement"/>
    <preference for="Centraliza\Connector\Messaging\Api\SendNotificationServiceInterface" type="Centraliza\Connector\Messaging\Service\OrderNotification\SendNotificationService"/>
    <preference for="Centraliza\Connector\Messaging\Api\QueueOrderNotificationServiceInterface" type="Centraliza\Connector\Messaging\Service\OrderNotification\QueueOrderNotificationService"/>
    <preference for="Centraliza\Connector\Messaging\Api\OrderPayloadBuilderInterface" type="Centraliza\Connector\Messaging\Model\OrderNotification\Payload\OrderPayloadBuilder"/>
    <preference for="Centraliza\Connector\Messaging\Api\OrderCreatedPayloadBuilderInterface" type="Centraliza\Connector\Messaging\Model\OrderNotification\Payload\OrderCreatedPayloadBuilder"/>
    <preference for="Centraliza\Connector\Messaging\Api\ResendNotificationServiceInterface" type="Centraliza\Connector\Messaging\Service\OrderNotification\ResendNotificationService"/>
    <virtualType name="CentralizaConnectorNotificationListingSearchResult" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">centraliza_notification</argument>
            <argument name="resourceModel" xsi:type="string">Centraliza\Connector\Messaging\Model\ResourceModel\OrderNotification\Notification</argument>
        </arguments>
    </virtualType>
    <type name="Centraliza\Connector\Messaging\Model\ResourceModel\DatabaseClock">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Observer\PublishOrderStatusChange">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Cron\OrderNotification\SendNotifications">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Controller\Adminhtml\OrderNotification\MassResend">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Controller\Adminhtml\OrderNotification\SendNow">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\OrderNotification\NotificationDeliveryManagement">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <argument name="debugLogger" xsi:type="object">CentralizaConnectorDebugLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\OrderNotification\Payload\OrderPayloadBuilder">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <!-- The storefront builder: in the admin area (Send now) UrlInterface would give an admin link. -->
            <argument name="urlBuilder" xsi:type="object">Magento\Framework\Url</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Service\OrderNotification\SendNotificationService">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <argument name="debugLogger" xsi:type="object">CentralizaConnectorDebugLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Service\OrderNotification\QueueOrderNotificationService">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\OrderNotification\Config">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>

    <!-- Abandoned carts and the cart recovery link, ported from Centraliza_Sales. -->
    <preference for="Centraliza\Connector\Messaging\Api\AbandonedCartConfigInterface" type="Centraliza\Connector\Messaging\Model\AbandonedCart\Config"/>
    <preference for="Centraliza\Connector\Messaging\Api\Data\AbandonedCartInterface" type="Centraliza\Connector\Messaging\Model\AbandonedCart\AbandonedCart"/>
    <preference for="Centraliza\Connector\Messaging\Api\AbandonedCartRepositoryInterface" type="Centraliza\Connector\Messaging\Model\AbandonedCart\AbandonedCartRepository"/>
    <preference for="Centraliza\Connector\Messaging\Api\AbandonedCartPayloadBuilderInterface" type="Centraliza\Connector\Messaging\Model\AbandonedCart\Payload\PayloadBuilder"/>
    <preference for="Centraliza\Connector\Messaging\Api\SelectAbandonedCartsServiceInterface" type="Centraliza\Connector\Messaging\Service\AbandonedCart\SelectAbandonedCartsService"/>
    <preference for="Centraliza\Connector\Messaging\Api\SendAbandonedCartsServiceInterface" type="Centraliza\Connector\Messaging\Service\AbandonedCart\SendAbandonedCartsService"/>
    <preference for="Centraliza\Connector\Messaging\Api\CartRedirectConfigInterface" type="Centraliza\Connector\Messaging\Model\CartRedirect\Config"/>
    <preference for="Centraliza\Connector\Messaging\Api\ReplaceCartServiceInterface" type="Centraliza\Connector\Messaging\Service\CartRedirect\ReplaceCartService"/>
    <virtualType name="CentralizaConnectorAbandonedCartListingSearchResult" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">centraliza_sales_abandoned_cart</argument>
            <argument name="resourceModel" xsi:type="string">Centraliza\Connector\Messaging\Model\ResourceModel\AbandonedCart</argument>
        </arguments>
    </virtualType>
    <type name="Centraliza\Connector\Messaging\Model\AbandonedCart\AbandonedCartRepository">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\AbandonedCart\AbandonmentPeriod">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\AbandonedCart\Payload\PayloadBuilder">
        <arguments>
            <argument name="debugLogger" xsi:type="object">CentralizaConnectorDebugLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Service\AbandonedCart\SelectAbandonedCartsService">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <argument name="debugLogger" xsi:type="object">CentralizaConnectorDebugLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Model\AbandonedCart\CartSender">
        <arguments>
            <!-- Marketing priority, so order notifications keep the key's last requests. -->
            <argument name="client" xsi:type="object">CentralizaConnectorMarketingClient</argument>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Service\AbandonedCart\SendAbandonedCartsService">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Cron\AbandonedCart\ProcessAbandonedCarts">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
            <argument name="debugLogger" xsi:type="object">CentralizaConnectorDebugLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Controller\Adminhtml\AbandonedCart\SendNow">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Service\CartRedirect\ReplaceCartService">
        <arguments>
            <!-- Session proxies: the sessions start only when the cart redirect actually reads them. -->
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Observer\RecordCartActivity">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Observer\CarryCartLinkOnMerge">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Messaging\Observer\ReplaceCustomerCartOnLogin">
        <arguments>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>
    <type name="Centraliza\Connector\Controller\Cart\Redirect\Index">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
            <argument name="logger" xsi:type="object">CentralizaConnectorSafeLogger</argument>
        </arguments>
    </type>

    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="centraliza_connector/general/api_key_production" xsi:type="string">1</item>
                <item name="centraliza_connector/general/api_key_staging" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="centraliza_connector/general/mode" xsi:type="string">1</item>
                <item name="centraliza_connector/general/environment" xsi:type="string">1</item>
                <item name="centraliza_connector/general/base_url_production" xsi:type="string">1</item>
                <item name="centraliza_connector/general/base_url_staging" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Catalog\Model\ResourceModel\Product\Action">
        <plugin name="centraliza_connector_record_mass_attribute_update" type="Centraliza\Connector\Entity\Product\Plugin\RecordMassAttributeUpdate"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="centraliza_connector_record_source_items_save" type="Centraliza\Connector\Entity\Stock\Plugin\RecordSourceItemsSave"/>
    </type>
    <type name="Magento\Inventory\Model\ResourceModel\SourceItem\DeleteMultiple">
        <plugin name="centraliza_connector_record_source_items_delete" type="Centraliza\Connector\Entity\Stock\Plugin\RecordSourceItemsDelete"/>
