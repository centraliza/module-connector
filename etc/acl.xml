<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- Outside Stores > Configuration on purpose: saving a role also grants every ancestor of a checked
                     resource, so a screen under the configuration node would hand its users the API key too. -->
                <resource id="Centraliza_Connector::centraliza_connector" title="Centraliza Connector" translate="title" sortOrder="81">
                    <resource id="Centraliza_Connector::manage" title="Dashboard and sends" translate="title" sortOrder="10"/>
                    <resource id="Centraliza_Connector::deliveries" title="Sent requests" translate="title" sortOrder="20"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Centraliza_Connector::config" title="Centraliza Connector" translate="title" sortOrder="81"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
