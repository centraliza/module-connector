<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global area on purpose: queue consumers and cron save entities there too. -->
    <event name="catalog_product_save_after">
        <observer name="centraliza_connector_record_product_save" instance="Centraliza\Connector\Entity\Product\Observer\RecordSave"/>
    </event>
    <event name="catalog_product_delete_before">
        <observer name="centraliza_connector_remember_product_websites" instance="Centraliza\Connector\Entity\Product\Observer\RecordDelete"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="centraliza_connector_record_product_delete" instance="Centraliza\Connector\Entity\Product\Observer\RecordDelete"/>
    </event>
    <event name="customer_group_delete_before">
        <observer name="centraliza_connector_record_group_tier_prices" instance="Centraliza\Connector\Entity\Price\Observer\RecordGroupDelete"/>
    </event>
    <event name="customer_save_before">
        <observer name="centraliza_connector_record_customer" instance="Centraliza\Connector\Entity\Customer\Observer\RecordCustomer"/>
    </event>
    <event name="customer_save_after">
        <observer name="centraliza_connector_record_customer" instance="Centraliza\Connector\Entity\Customer\Observer\RecordCustomer"/>
    </event>
    <event name="customer_delete_before">
        <observer name="centraliza_connector_record_customer" instance="Centraliza\Connector\Entity\Customer\Observer\RecordCustomer"/>
    </event>
    <event name="customer_delete_after">
        <observer name="centraliza_connector_record_customer" instance="Centraliza\Connector\Entity\Customer\Observer\RecordCustomer"/>
    </event>
    <event name="customer_address_save_before">
        <observer name="centraliza_connector_record_customer_address" instance="Centraliza\Connector\Entity\Customer\Observer\RecordAddress"/>
    </event>
    <event name="customer_address_save_after">
        <observer name="centraliza_connector_record_customer_address" instance="Centraliza\Connector\Entity\Customer\Observer\RecordAddress"/>
    </event>
    <event name="customer_address_delete_before">
        <observer name="centraliza_connector_record_customer_address" instance="Centraliza\Connector\Entity\Customer\Observer\RecordAddress"/>
    </event>
    <event name="customer_address_delete_after">
        <observer name="centraliza_connector_record_customer_address" instance="Centraliza\Connector\Entity\Customer\Observer\RecordAddress"/>
    </event>
    <event name="customer_group_save_after">
        <observer name="centraliza_connector_record_customer_group" instance="Centraliza\Connector\Entity\CustomerGroup\Observer\RecordGroup"/>
    </event>
    <event name="customer_group_delete_after">
        <observer name="centraliza_connector_record_customer_group" instance="Centraliza\Connector\Entity\CustomerGroup\Observer\RecordGroup"/>
    </event>
    <event name="sales_order_save_after">
        <observer name="centraliza_connector_record_order" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrder"/>
    </event>
    <event name="sales_order_invoice_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_shipment_track_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_shipment_track_delete_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_status_history_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_order_address_save_after">
        <observer name="centraliza_connector_record_order_part" instance="Centraliza\Connector\Entity\Order\Observer\RecordOrderPart"/>
    </event>
    <event name="sales_quote_save_after">
        <observer name="centraliza_connector_record_cart" instance="Centraliza\Connector\Entity\Cart\Observer\RecordCart"/>
    </event>
    <event name="sales_quote_delete_after">
        <observer name="centraliza_connector_record_cart" instance="Centraliza\Connector\Entity\Cart\Observer\RecordCart"/>
    </event>
    <event name="sales_quote_item_save_after">
        <observer name="centraliza_connector_record_cart_part" instance="Centraliza\Connector\Entity\Cart\Observer\RecordCartPart"/>
    </event>
    <event name="sales_quote_item_delete_after">
        <observer name="centraliza_connector_record_cart_part" instance="Centraliza\Connector\Entity\Cart\Observer\RecordCartPart"/>
    </event>
    <event name="sales_quote_address_save_after">
        <observer name="centraliza_connector_record_cart_part" instance="Centraliza\Connector\Entity\Cart\Observer\RecordCartPart"/>
    </event>
    <!-- Order notifications. _commit_after, not _save_after: the first fires once the transaction has committed,
         the second inside it, and would notify a change that can still be rolled back. The observer name is apart
         from the legacy one, which the same name would replace while Centraliza_Sales is installed. -->
    <!-- Cart recovery link, ported from Centraliza_Sales: the link's mark follows a merged cart and reaches the order.
         Both do nothing while Centraliza_Sales is enabled. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="centraliza_connector_copy_cart_origin_to_order" instance="Centraliza\Connector\Messaging\Observer\CopyCartOriginToOrder"/>
    </event>
    <event name="sales_quote_merge_after">
        <observer name="centraliza_connector_carry_cart_link_on_merge" instance="Centraliza\Connector\Messaging\Observer\CarryCartLinkOnMerge"/>
    </event>
    <event name="sales_order_save_commit_after">
        <observer name="centraliza_connector_order_notification" instance="Centraliza\Connector\Messaging\Observer\PublishOrderStatusChange"/>
    </event>
</config>
