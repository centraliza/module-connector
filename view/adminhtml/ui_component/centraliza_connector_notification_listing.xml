<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">centraliza_connector_notification_listing.centraliza_connector_notification_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="send_now" class="CentralizaConnectorNotificationSendNowButton"/>
        </buttons>
        <spinner>centraliza_connector_notification_columns</spinner>
        <deps>
            <dep>centraliza_connector_notification_listing.centraliza_connector_notification_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="centraliza_connector_notification_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Centraliza_Notification::notification_log</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="centraliza_connector_notification_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <!-- No export: last_error_message is third-party text that could carry a spreadsheet formula. -->
        <massaction name="listing_massaction"
                    class="Centraliza\Connector\Messaging\Ui\Component\Listing\AuthorizedMassAction">
            <action name="resend">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">Centraliza_Notification::notification_resend</item>
                    </item>
                </argument>
                <settings>
                    <confirm>
                        <message translate="true">Resend the selected notifications? Each one resent sends the customer the message again.</message>
                        <title translate="true">Resend notifications</title>
                    </confirm>
                    <url path="centraliza_connector/ordernotification/massResend"/>
                    <type>resend</type>
                    <label translate="true">Resend</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="centraliza_connector_notification_columns">
        <selectionsColumn name="ids" sortOrder="10">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <!-- Same order as created_at, served by the primary key. -->
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="increment_id" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Order</label>
            </settings>
        </column>
        <column name="event_type" component="Magento_Ui/js/grid/columns/select" sortOrder="35">
            <settings>
                <options class="Centraliza\Connector\Messaging\Ui\Component\Listing\Column\EventType\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Event</label>
            </settings>
        </column>
        <column name="website_id" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Magento\Store\Model\ResourceModel\Website\Collection"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Website</label>
            </settings>
        </column>
        <column name="to_status" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Magento\Sales\Ui\Component\Listing\Column\Status\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Notified Status</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Centraliza\Connector\Messaging\Ui\Component\Listing\Column\NotificationStatus\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Delivery State</label>
            </settings>
        </column>
        <column name="attempts" sortOrder="90">
            <settings>
                <filter>textRange</filter>
                <dataType>number</dataType>
                <label translate="true">Sends</label>
            </settings>
        </column>
        <!-- Shown as the raw number: a select column renders a blank cell for a code outside its list, such as 0. -->
        <column name="last_error_code" sortOrder="100">
            <settings>
                <options class="Centraliza\Connector\Messaging\Model\Api\Source\HttpStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Error Code</label>
            </settings>
        </column>
        <!-- The default text cell escapes the value: the message is third-party text, never trusted as markup. -->
        <column name="last_error_message" sortOrder="110">
            <settings>
                <label translate="true">Error Message</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="external_id" sortOrder="120">
            <settings>
                <filter>text</filter>
                <label translate="true">Centraliza ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="next_attempt_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="130">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Next Attempt</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="delivered_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="140">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Accepted At</label>
            </settings>
        </column>
        <column name="sent_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="150">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Dispatch Reported At</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="160">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
    </columns>
</listing>
