<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global area on purpose: queue consumers and cron save entities there too. -->
    <event name="catalog_product_save_after">
        <observer name="centraliza_connector_record_product_save" instance="Centraliza\Connector\Entity\Product\Observer\RecordSave"/>
    </event>
    <event name="catalog_product_delete_before">
        <observer name="centraliza_connector_remember_product_websites" instance="Centraliza\Connector\Entity\Product\Observer\RecordDelete"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="centraliza_connector_record_product_delete" instance="Centraliza\Connector\Entity\Product\Observer\RecordDelete"/>
    </event>
    <event name="customer_group_delete_before">
        <observer name="centraliza_connector_record_group_tier_prices" instance="Centraliza\Connector\Entity\Price\Observer\RecordGroupDelete"/>
    </event>
</config>
