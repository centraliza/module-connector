<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <!-- As in Centraliza_Sales (same field, so the two declarations merge): the fieldset copies the column in
         ToOrder::convert(), and the CopyCartOriginToOrder observer does the copy that counts, because
         QuoteManagement::submitQuote() and Multishipping::_prepareOrder() rebuild the order through the
         OrderInterface getters and drop it. -->
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="centraliza_masked_id">
                <aspect name="to_order"/>
            </field>
        </fieldset>
    </scope>
</config>
