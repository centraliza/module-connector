<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="centraliza_connector_retry_due" instance="Centraliza\Connector\Cron\RetryDue" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="centraliza_connector_report_health" instance="Centraliza\Connector\Cron\ReportHealth" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
