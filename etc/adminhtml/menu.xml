<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/menu.xsd">
    <menu>
        <!--
            The part of each id after "::" becomes the CSS class of the item (item-<part>), and the admin theme
            styles some of those classes: "dashboard" would get the icon of the admin Dashboard. Every id here
            starts with centraliza_ so none of them takes another item's style; item-centraliza-connector carries
            the icon of this menu (view/adminhtml/web/css/menu.css).
        -->
        <add id="Centraliza_Connector::centraliza_connector" title="Centraliza" translate="title"
             module="Centraliza_Connector" sortOrder="81" resource="Centraliza_Connector::centraliza_connector"/>
        <add id="Centraliza_Connector::centraliza_dashboard" title="Dashboard" translate="title" module="Centraliza_Connector"
             sortOrder="10" parent="Centraliza_Connector::centraliza_connector"
             action="centraliza_connector/dashboard/index" resource="Centraliza_Connector::manage"/>
        <add id="Centraliza_Connector::centraliza_deliveries" title="Sent Requests" translate="title" module="Centraliza_Connector"
             sortOrder="20" parent="Centraliza_Connector::centraliza_connector"
             action="centraliza_connector/delivery/index" resource="Centraliza_Connector::deliveries"/>
        <add id="Centraliza_Connector::centraliza_configuration" title="Configuration" translate="title" module="Centraliza_Connector"
             sortOrder="30" parent="Centraliza_Connector::centraliza_connector"
             action="adminhtml/system_config/edit/section/centraliza_connector" resource="Centraliza_Connector::config"/>
    </menu>
</config>
