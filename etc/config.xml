<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <centraliza_connector>
            <general>
                <enabled>0</enabled>
                <mode>dry_run</mode>
                <environment>production</environment>
                <api_key_production backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <connection_id_production/>
                <base_url_production>https://api.centraliza.ai</base_url_production>
                <api_key_staging backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <connection_id_staging/>
                <base_url_staging>https://api.centraliza.dev</base_url_staging>
                <telemetry_log>0</telemetry_log>
                <debug>0</debug>
            </general>
            <carts>
                <guests>0</guests>
            </carts>
            <delivery>
                <max_attempts>5</max_attempts>
                <request_limit>60</request_limit>
                <bulk_quota_floor>30</bulk_quota_floor>
            </delivery>
            <order_notification>
                <enabled>0</enabled>
                <!-- Off until Centraliza confirms the order.created event and the cart on status events: a 4xx on a
                     status event fails it for good, so a deploy must not turn them on by itself. -->
                <order_created_enabled>0</order_created_enabled>
                <retry_enabled>1</retry_enabled>
                <give_up_hours>24</give_up_hours>
                <max_attempts>5</max_attempts>
            </order_notification>
            <abandoned_cart>
                <enabled>0</enabled>
                <abandon_minutes>60</abandon_minutes>
                <send_limit_minutes>1440</send_limit_minutes>
                <max_notifications>1</max_notifications>
            </abandoned_cart>
            <cart_redirect>
                <enabled>0</enabled>
            </cart_redirect>
        </centraliza_connector>
    </default>
</config>
