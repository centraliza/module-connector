<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">centraliza_connector_pending_listing.centraliza_connector_pending_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="dashboard">
                <url path="*/dashboard/index"/>
                <class>back</class>
                <label translate="true">Dashboard</label>
            </button>
            <button name="deliveries">
                <url path="*/delivery/index"/>
                <class>secondary</class>
                <label translate="true">Sent Requests</label>
            </button>
        </buttons>
        <spinner>centraliza_connector_pending_columns</spinner>
        <deps>
            <dep>centraliza_connector_pending_listing.centraliza_connector_pending_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="centraliza_connector_pending_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">pending_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Centraliza_Connector::deliveries</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="centraliza_connector_pending_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>pending_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <!-- No export: record keys of customers carry their e-mail. -->
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="centraliza_connector_pending_columns">
        <column name="occurred_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
                <label translate="true">Changed At</label>
            </settings>
        </column>
        <column name="state" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="Centraliza\Connector\Model\Config\Source\PendingState"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Where It Is</label>
            </settings>
        </column>
        <column name="stream" component="Magento_Ui/js/grid/columns/select" sortOrder="30">
            <settings>
                <options class="Centraliza\Connector\Model\Config\Source\Stream"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Entity</label>
            </settings>
        </column>
        <column name="verb" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Event</label>
            </settings>
        </column>
        <column name="record_key" sortOrder="50">
            <settings>
                <filter>text</filter>
                <sortable>false</sortable>
                <label translate="true">Record</label>
            </settings>
        </column>
        <column name="lane" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Lane</label>
            </settings>
        </column>
        <column name="attempts" sortOrder="70">
            <settings>
                <label translate="true">Failed Attempts</label>
            </settings>
        </column>
        <column name="next_attempt_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Next Attempt</label>
            </settings>
        </column>
        <column name="detail" sortOrder="90">
            <settings>
                <filter>text</filter>
                <sortable>false</sortable>
                <label translate="true">Last Error</label>
            </settings>
        </column>
        <column name="idempotency_key" sortOrder="100">
            <settings>
                <filter>text</filter>
                <visible>false</visible>
                <label translate="true">Idempotency Key</label>
            </settings>
        </column>
    </columns>
</listing>
