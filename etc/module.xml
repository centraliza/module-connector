<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Centraliza_Connector">
        <sequence>
            <!-- After the legacy Centraliza modules when they are installed (a module that is not is skipped): the
                 storefront route of the cart link is answered by the first module listed, and that must be the
                 legacy one while it is enabled. -->
            <module name="Centraliza_Base"/>
            <module name="Centraliza_Sales"/>
            <module name="Magento_MessageQueue"/>
            <module name="Magento_Cron"/>
            <module name="Magento_Store"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Eav"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Inventory"/>
            <module name="Magento_InventoryApi"/>
            <module name="Magento_InventoryCatalogApi"/>
            <module name="Magento_InventorySalesApi"/>
            <module name="Magento_Config"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Ui"/>
            <module name="Magento_Webapi"/>
            <module name="Magento_Authorization"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_ConfigurableProduct"/>
        </sequence>
    </module>
</config>
